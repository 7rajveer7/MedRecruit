# Local API
PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DATA_DIR=data
DATABASE_PATH=data/medrecruit.sqlite
UPLOAD_DIR=storage/resumes

# Optional AI drafts; leave blank to use local fallback text.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional Google Calendar OAuth. Without it, MedRecruit creates a Jitsi room instead.
# Configure this to create scheduled Calendar events and Google Meet links.
# Request the https://www.googleapis.com/auth/calendar.events scope for the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
